@model Restaurante.Models.Mesa

@{
    ViewData["Title"] = "Editar mesa";
}

<div class="container-fluid">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a mesas
        </a>

        <h1 class="fw-bold mt-3 mb-1">Editar mesa</h1>
        <p class="text-muted mb-0">Modifica los datos de la mesa.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ID_Mesa" />
                <partial name="_FormMesa" model="Model" />

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>
                        Guardar cambios
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
