@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<Restaurante.Models.Mesa>

@{
    ViewData["Title"] = "Mesas";

    var libres = Model.Count(m => m.Estado == EstadoMesa.Libre);
    var ocupadas = Model.Count(m => m.Estado == EstadoMesa.Ocupada);
    var reservadas = Model.Count(m => m.Estado == EstadoMesa.Reservada);

    string ClaseEstado(EstadoMesa e) => e switch
    {
        EstadoMesa.Libre => "libre",
        EstadoMesa.Ocupada => "ocupada",
        _ => "reservada"
    };

    IEnumerable<SelectListItem> OpcionesEstado(EstadoMesa actual) =>
        Html.GetEnumSelectList<EstadoMesa>().Select(i =>
            new SelectListItem(i.Text, i.Value, i.Value == ((int)actual).ToString()));
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Mesas</h1>
            <p class="text-muted mb-0">
                Consulta el estado de las mesas del restaurante.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-warning fw-semibold">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva mesa
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="mesa-resumen mb-4">
        <span class="mesa-chip libre"><i class="bi bi-circle-fill"></i> Libres: @libres</span>
        <span class="mesa-chip ocupada"><i class="bi bi-circle-fill"></i> Ocupadas: @ocupadas</span>
        <span class="mesa-chip reservada"><i class="bi bi-circle-fill"></i> Reservadas: @reservadas</span>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-grid-3x3-gap fs-1 text-muted"></i>
                <p class="fw-semibold mt-3 mb-1">No hay mesas registradas</p>
                <p class="text-muted mb-3">Registra la primera mesa del restaurante.</p>
                <a asp-action="Create" class="btn btn-warning fw-semibold">Nueva mesa</a>
            </div>
        </div>
    }
    else
    {
        <div class="mesas-grid">
            @foreach (var mesa in Model)
            {
                <div class="mesa-card @ClaseEstado(mesa.Estado)">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="mesa-numero">Mesa @mesa.Numero</div>
                            <div class="text-muted small">
                                <i class="bi bi-people"></i> @mesa.Capacidad personas
                                @if (!string.IsNullOrWhiteSpace(mesa.Ubicacion))
                                {
                                    <span> · @mesa.Ubicacion</span>
                                }
                            </div>
                        </div>
                        <span class="mesa-estado">@mesa.Estado</span>
                    </div>

                    <div class="mesa-acciones">
                        <form asp-action="CambiarEstado" method="post" class="d-flex gap-2 flex-grow-1">
                            <input type="hidden" name="id" value="@mesa.ID_Mesa" />
                            <select name="estado" class="form-select form-select-sm"
                                    asp-items="@OpcionesEstado(mesa.Estado)"
                                    onchange="this.form.submit()">
                            </select>
                        </form>
                        <a asp-action="Edit" asp-route-id="@mesa.ID_Mesa"
                           class="btn btn-sm btn-outline-warning" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@mesa.ID_Mesa"
                           class="btn btn-sm btn-outline-danger" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }

</div>
