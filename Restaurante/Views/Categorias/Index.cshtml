@model IEnumerable<Restaurante.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Categorías</h1>
            <p class="text-muted mb-0">
                Administra las categorías de los productos del restaurante.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-warning fw-semibold">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva categoría
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-semibold mb-0">Lista de categorías</h5>

                <span class="badge bg-secondary">
                    Total: @(Model?.Count() ?? 0)
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var categoria in Model)
                            {
                                <tr>
                                    <td>@categoria.ID_Categoria</td>

                                    <td class="fw-semibold">
                                        @categoria.Nombre
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(categoria.Descripcion)
                                            ? "Sin descripción"
                                            : categoria.Descripcion)
                                    </td>

                                    <td>
                                        @if (categoria.Estado)
                                        {
                                            <span class="badge bg-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactiva
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@categoria.ID_Categoria"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@categoria.ID_Categoria"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@categoria.ID_Categoria"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-folder2-open fs-1 text-muted"></i>

                                    <p class="fw-semibold mt-3 mb-1">
                                        No hay categorías registradas
                                    </p>

                                    <p class="text-muted mb-3">
                                        Crea tu primera categoría para comenzar.
                                    </p>

                                    <a asp-action="Create"
                                       class="btn btn-warning fw-semibold">
                                        Nueva categoría
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
