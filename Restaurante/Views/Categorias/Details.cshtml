@model Restaurante.Models.Categoria

@{
    ViewData["Title"] = "Detalles de categoría";
}

<div class="container-fluid">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a categorías
        </a>

        <h1 class="fw-bold mt-3 mb-1">Detalles de categoría</h1>
        <p class="text-muted mb-0">
            Consulta la información registrada de esta categoría.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-semibold mb-0">Información de la categoría</h5>

                @if (Model.Estado)
                {
                    <span class="badge bg-success">Activa</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactiva</span>
                }
            </div>

            <dl class="row mb-4">

                <dt class="col-sm-3 text-muted">
                    ID de categoría
                </dt>
                <dd class="col-sm-9 fw-semibold">
                    @Model.ID_Categoria
                </dd>

                <dt class="col-sm-3 text-muted">
                    Nombre
                </dt>
                <dd class="col-sm-9">
                    @Model.Nombre
                </dd>

                <dt class="col-sm-3 text-muted">
                    Descripción
                </dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                    {
                        @Model.Descripcion
                    }
                    else
                    {
                        <span class="text-muted">Sin descripción</span>
                    }
                </dd>

                <dt class="col-sm-3 text-muted">
                    Estado
                </dt>
                <dd class="col-sm-9">
                    @(Model.Estado ? "Activa" : "Inactiva")
                </dd>

            </dl>

            <hr />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Volver
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.ID_Categoria"
                   class="btn btn-warning fw-semibold">
                    <i class="bi bi-pencil me-1"></i>
                    Editar categoría
                </a>
            </div>

        </div>
    </div>

</div>
