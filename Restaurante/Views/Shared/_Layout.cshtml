
@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(string controlador) => controladorActual == controlador ? "selected" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RESTAURANTE ISI</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurante.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-layout">

        <aside class="sidebar">
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                <span class="brand-symbol">R</span>
                <span>
                    <strong>RESTAURANTE ISI</strong>
                    <small>GESTIÓN RESTAURANTE</small>
                </span>
            </a>

            <div class="sidebar-section">MENÚ PRINCIPAL</div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index"
                   class="sidebar-link @Activo("Home")">
                    <span class="nav-icon">⌂</span> Dashboard
                </a>

                <a asp-controller="Pedidos" asp-action="Index" class="sidebar-link @Activo("Pedidos")">
                    <span class="nav-icon">▤</span> Pedidos
                </a>

                <a asp-controller="Productos" asp-action="Index" class="sidebar-link @Activo("Productos")">
                    <span class="nav-icon">♨</span> Productos
                </a>

                <a asp-controller="Categorias" asp-action="Index" class="sidebar-link @Activo("Categorias")">
                    <span class="nav-icon">▦</span> Categorías
                </a>

                <a asp-controller="Mesas" asp-action="Index" class="sidebar-link @Activo("Mesas")">
                    <span class="nav-icon">▧</span> Mesas
                </a>

                <div class="sidebar-section">GESTIÓN</div>

                <a asp-controller="Clientes" asp-action="Index" class="sidebar-link @Activo("Clientes")">
                    <span class="nav-icon">♙</span> Clientes
                </a>

                <a asp-controller="Empleados" asp-action="Index" class="sidebar-link @Activo("Empleados")">
                    <span class="nav-icon">♧</span> Empleados
                </a>

                <a asp-controller="Facturas" asp-action="Index" class="sidebar-link @Activo("Facturas")">
                    <span class="nav-icon">▣</span> Facturas
                </a>

                <a asp-controller="Reportes" asp-action="Index" class="sidebar-link @Activo("Reportes")">
                    <span class="nav-icon">▥</span> Reportes
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-status"></div>
                <div>
                    <strong>Sistema interno</strong>
                    <small>Administración</small>
                </div>
            </div>
        </aside>

        <div class="admin-main">
            <header class="topbar">
                <div>
                    <div class="topbar-title">Panel de administración</div>
                    <div class="topbar-subtitle">Control y gestión del restaurante</div>
                </div>

                <div class="topbar-user">
                    <span class="user-avatar">A</span>
                    <div>
                        <strong>Administrador</strong>
                        <small>Gestión interna</small>
                    </div>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                RESTAURANTE ISI · Sistema de gestión del restaurante
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
