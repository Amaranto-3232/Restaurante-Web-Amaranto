@model IEnumerable<Restaurante.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
    var filtro = ViewBag.EstadoFiltro as EstadoPedido?;
    var estados = Enum.GetValues<EstadoPedido>();
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Pedidos</h1>
            <p class="text-muted mb-0">
                Consulta y administra los pedidos del restaurante.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-warning fw-semibold">
            <i class="bi bi-plus-lg me-1"></i>
            Nuevo pedido
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <div class="filtro-estados mb-3">
        <a asp-action="Index" class="filtro-estado @(filtro == null ? "activo" : "")">Todos</a>
        @foreach (var e in estados)
        {
            <a asp-action="Index" asp-route-estado="@e"
               class="filtro-estado @(filtro == e ? "activo" : "")">@e.NombreVisible()</a>
        }
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-semibold mb-0">Lista de pedidos</h5>
                <span class="badge bg-secondary">Total: @Model.Count()</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>N.º</th>
                            <th>Fecha</th>
                            <th>Mesa</th>
                            <th>Cliente</th>
                            <th>Productos</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var pedido in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">#@pedido.ID_Pedido</td>
                                    <td>@pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>Mesa @pedido.Mesa?.Numero</td>
                                    <td>@(pedido.Cliente ?? "Sin cliente")</td>
                                    <td>@pedido.Detalles.Sum(d => d.Cantidad)</td>
                                    <td class="fw-semibold">Bs @pedido.Total.ToString("N2")</td>
                                    <td><partial name="_EstadoBadge" model="pedido.Estado" /></td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@pedido.ID_Pedido"
                                               class="btn btn-sm btn-outline-secondary" title="Ver detalle">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@pedido.ID_Pedido"
                                               class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="bi bi-receipt fs-1 text-muted"></i>
                                    <p class="fw-semibold mt-3 mb-1">No hay pedidos para mostrar</p>
                                    <p class="text-muted mb-3">Registra un pedido para una mesa libre.</p>
                                    <a asp-action="Create" class="btn btn-warning fw-semibold">Nuevo pedido</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
