@model Restaurante.Models.Pedido

@{
    ViewData["Title"] = $"Pedido #{Model.ID_Pedido}";
    var abierto = Model.Estado == EstadoPedido.Pendiente || Model.Estado == EstadoPedido.EnPreparacion;
}

<div class="container-fluid">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a pedidos
        </a>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                <h1 class="fw-bold mb-1">Pedido #@Model.ID_Pedido</h1>
                <p class="text-muted mb-0">
                    Mesa @Model.Mesa?.Numero · @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>
            <partial name="_EstadoBadge" model="Model.Estado" />
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-semibold mb-3">Productos del pedido</h5>
                    <partial name="_TablaDetalle" model="Model" />
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-semibold mb-3">Información</h5>
                    <dl class="mb-0">
                        <dt>Cliente</dt>
                        <dd>@(Model.Cliente ?? "Sin cliente")</dd>
                        <dt>Observación</dt>
                        <dd class="mb-0">@(Model.Observacion ?? "Ninguna")</dd>
                    </dl>
                </div>
            </div>

            @if (abierto)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Actualizar estado</h5>

                        @if (Model.Estado == EstadoPedido.Pendiente)
                        {
                            <form asp-action="CambiarEstado" method="post" class="mb-2">
                                <input type="hidden" name="id" value="@Model.ID_Pedido" />
                                <input type="hidden" name="estado" value="@EstadoPedido.EnPreparacion" />
                                <button class="btn btn-warning fw-semibold w-100">
                                    <i class="bi bi-fire me-1"></i> Pasar a preparación
                                </button>
                            </form>
                        }

                        <form asp-action="CambiarEstado" method="post" class="mb-2">
                            <input type="hidden" name="id" value="@Model.ID_Pedido" />
                            <input type="hidden" name="estado" value="@EstadoPedido.Entregado" />
                            <button class="btn btn-success w-100">
                                <i class="bi bi-check2-circle me-1"></i> Marcar como entregado
                            </button>
                        </form>

                        <form asp-action="CambiarEstado" method="post">
                            <input type="hidden" name="id" value="@Model.ID_Pedido" />
                            <input type="hidden" name="estado" value="@EstadoPedido.Cancelado" />
                            <button class="btn btn-outline-danger w-100">
                                <i class="bi bi-x-circle me-1"></i> Cancelar pedido
                            </button>
                        </form>

                        <p class="form-text mb-0 mt-3">
                            Al entregar o cancelar, la mesa vuelve a quedar libre.
                        </p>
                    </div>
                </div>
            }
        </div>

    </div>

</div>
