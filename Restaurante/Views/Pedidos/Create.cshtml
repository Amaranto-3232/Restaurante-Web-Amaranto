@model Restaurante.ViewModels.PedidoViewModel

@{
    ViewData["Title"] = "Nuevo pedido";
    var categorias = Model.Productos.GroupBy(p => p.Categoria);
}

<div class="container-fluid">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a pedidos
        </a>

        <h1 class="fw-bold mt-3 mb-1">Nuevo pedido</h1>
        <p class="text-muted mb-0">Elige la mesa y agrega los productos del pedido.</p>
    </div>

    <form asp-action="Create" method="post" id="form-pedido">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Datos del pedido</h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ID_Mesa" class="form-label fw-semibold"></label>
                                <select asp-for="ID_Mesa" asp-items="Model.Mesas" class="form-select">
                                    <option value="">-- Selecciona una mesa --</option>
                                </select>
                                <span asp-validation-for="ID_Mesa" class="text-danger"></span>
                                @if (!Model.Mesas.Any())
                                {
                                    <div class="form-text text-danger">
                                        No hay mesas libres. <a asp-controller="Mesas" asp-action="Index">Revisa las mesas</a>.
                                    </div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Cliente" class="form-label fw-semibold"></label>
                                <input asp-for="Cliente" class="form-control" list="lista-clientes"
                                       placeholder="Escribe para buscar un cliente" autocomplete="off" />
                                <datalist id="lista-clientes">
                                    @foreach (var c in Model.Clientes)
                                    {
                                        <option value="@c"></option>
                                    }
                                </datalist>
                            </div>

                            <div class="col-12">
                                <label asp-for="Observacion" class="form-label fw-semibold"></label>
                                <input asp-for="Observacion" class="form-control"
                                       placeholder="Ej. Sin picante, para llevar" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-semibold mb-0">Productos</h5>
                            <button type="button" id="agregar-linea" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-plus-lg me-1"></i>
                                Agregar producto
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="min-width: 220px">Producto</th>
                                        <th style="width: 110px">Cantidad</th>
                                        <th style="width: 120px">Precio</th>
                                        <th style="width: 120px">Subtotal</th>
                                        <th style="width: 50px"></th>
                                    </tr>
                                </thead>
                                <tbody id="lineas">
                                    @for (int i = 0; i < Model.Lineas.Count; i++)
                                    {
                                        <tr class="linea">
                                            <td>
                                                <select name="Lineas[@i].ID_Producto" class="form-select producto">
                                                    <option value="0">-- Selecciona --</option>
                                                    @foreach (var grupo in categorias)
                                                    {
                                                        <optgroup label="@grupo.Key">
                                                            @foreach (var p in grupo)
                                                            {
                                                                <option value="@p.Id" data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                        selected="@(p.Id == Model.Lineas[i].ID_Producto)">@p.Nombre</option>
                                                            }
                                                        </optgroup>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input name="Lineas[@i].Cantidad" type="number" min="1" max="100"
                                                       value="@Model.Lineas[i].Cantidad" class="form-control cantidad" />
                                            </td>
                                            <td class="precio text-muted">Bs 0.00</td>
                                            <td class="subtotal fw-semibold">Bs 0.00</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger quitar" title="Quitar">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm pedido-resumen">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Resumen</h5>

                        <div class="d-flex justify-content-between mb-2 text-muted">
                            <span>Productos</span>
                            <span id="total-items">0</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="fw-semibold">Total</span>
                            <span class="pedido-total" id="total">Bs 0.00</span>
                        </div>

                        <button type="submit" class="btn btn-warning fw-semibold w-100 mt-4">
                            <i class="bi bi-check-lg me-1"></i>
                            Registrar pedido
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
                    </div>
                </div>
            </div>

        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const cuerpo = document.getElementById('lineas');
            const formato = n => 'Bs ' + n.toFixed(2);

            // Vuelve a numerar Lineas[0], Lineas[1]... para que el model binding funcione
            function renumerar() {
                cuerpo.querySelectorAll('tr.linea').forEach((fila, i) => {
                    fila.querySelector('.producto').name = `Lineas[${i}].ID_Producto`;
                    fila.querySelector('.cantidad').name = `Lineas[${i}].Cantidad`;
                });
            }

            function recalcular() {
                let total = 0, items = 0;
                cuerpo.querySelectorAll('tr.linea').forEach(fila => {
                    const opcion = fila.querySelector('.producto').selectedOptions[0];
                    const precio = parseFloat(opcion?.dataset.precio || 0);
                    const cantidad = parseInt(fila.querySelector('.cantidad').value || 0);
                    const subtotal = precio * cantidad;
                    fila.querySelector('.precio').textContent = formato(precio);
                    fila.querySelector('.subtotal').textContent = formato(subtotal);
                    total += subtotal;
                    if (precio > 0) items += cantidad;
                });
                document.getElementById('total').textContent = formato(total);
                document.getElementById('total-items').textContent = items;
            }

            document.getElementById('agregar-linea').addEventListener('click', () => {
                const nueva = cuerpo.querySelector('tr.linea').cloneNode(true);
                nueva.querySelector('.producto').value = '0';
                nueva.querySelector('.cantidad').value = 1;
                cuerpo.appendChild(nueva);
                renumerar();
                recalcular();
                nueva.querySelector('.producto').focus();
            });

            cuerpo.addEventListener('click', e => {
                const boton = e.target.closest('.quitar');
                if (!boton) return;
                const filas = cuerpo.querySelectorAll('tr.linea');
                if (filas.length === 1) {
                    filas[0].querySelector('.producto').value = '0';
                    filas[0].querySelector('.cantidad').value = 1;
                } else {
                    boton.closest('tr').remove();
                }
                renumerar();
                recalcular();
            });

            cuerpo.addEventListener('input', recalcular);
            cuerpo.addEventListener('change', recalcular);
            recalcular();
        })();
    </script>
}
