@model Restaurante.Models.Pedido

@{
    ViewData["Title"] = "Eliminar pedido";
}

<div class="container-fluid">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a pedidos
        </a>

        <h1 class="fw-bold mt-3 mb-1">Eliminar pedido #@Model.ID_Pedido</h1>
        <p class="text-muted mb-0">
            Mesa @Model.Mesa?.Numero · @Model.Fecha.ToString("dd/MM/yyyy HH:mm") ·
            <partial name="_EstadoBadge" model="Model.Estado" />
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <partial name="_TablaDetalle" model="Model" />

            <div class="alert alert-warning mt-4 mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Se eliminará el pedido junto con sus productos. Esta acción no se puede deshacer.
            </div>

            <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                <input type="hidden" asp-for="ID_Pedido" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>
                    Eliminar pedido
                </button>
            </form>

        </div>
    </div>

</div>
