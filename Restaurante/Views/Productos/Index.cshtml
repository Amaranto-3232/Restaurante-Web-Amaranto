@model IEnumerable<Restaurante.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Productos</h1>
            <p class="text-muted mb-0">
                Administración de productos del restaurante.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-warning fw-semibold">
            <i class="bi bi-plus-lg me-1"></i>
            Nuevo producto
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-semibold mb-0">Lista de productos</h5>

                <span class="badge bg-secondary">
                    Total: @(Model?.Count() ?? 0)
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Nombre</td>
                                    <td>@(item.Categoria?.Nombre ?? "Sin categoría")</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Descripcion)
                                            ? "Sin descripción"
                                            : item.Descripcion)
                                    </td>
                                    <td>Bs @item.Precio.ToString("N2")</td>
                                    <td>
                                        @if (item.Estado)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@item.ID_Producto"
                                               class="btn btn-sm btn-outline-secondary" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ID_Producto"
                                               class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ID_Producto"
                                               class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="bi bi-basket fs-1 text-muted"></i>
                                    <p class="fw-semibold mt-3 mb-1">No hay productos registrados</p>
                                    <p class="text-muted mb-3">Agrega tu primer producto para comenzar.</p>
                                    <a asp-action="Create" class="btn btn-warning fw-semibold">Nuevo producto</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
